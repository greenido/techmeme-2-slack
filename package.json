{
  "name": "techmeme-daily-digest",
  "version": "1.0.0",
  "description": "Fetches top news from Techmeme, summarizes with Gemini, and posts to Slack and/or Telegram.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:telegram": "node index.js --telegram-only",
    "start:dry-run": "node index.js --dry-run",
    "test:telegram": "node telegram-test.js"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@slack/web-api": "^6.10.0",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.3.1"
  }
}
